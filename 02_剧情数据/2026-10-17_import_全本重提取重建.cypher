MERGE (n:Info {id: 'RINsONAONr'}) SET n.title = '苏晓禾对照顾的人投入真感情、被离世击中软肋', n.content = 'E23（老人离世致情绪低落）→ 「照顾别人」不是工作而是情感寄托', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONs'}) SET n.title = '沈暮雪外冷内细、直球高效', n.content = 'I26（私信三句无寒暄）+ I29/E24（道歉与预告用同一批词）+「她细心的帮他加了糖」→ 冷面之下极细心', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONt'}) SET n.title = '沈暮雪顶住江烈反对挖人、另有未言明的理由', n.content = 'E25（「那为什么顶着他挖我」「等你值得得到答案的时候，我自然会告诉你」）→ 挖人动机未摊牌', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONu'}) SET n.title = '江烈极端重视团队协作、对个人主义零容忍', n.content = 'I28（「比赛是五个人的」斥责+顶撞即翻脸）→ 团队至上信念', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONv'}) SET n.title = '陆择开始把宿主的人生当自己的经营', n.content = 'E17（算的是「陈默的人生账」、收拾屋子、定闹钟）→ 从完成任务转向经营人生', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONw'}) SET n.title = '三女主都对陈默抱有好感', n.content = 'I31（同日发信三选一）+ I39（林梦）/E23·I42（苏晓禾）/E25·I44（沈暮雪）各自线索 → 三线并进的感情基础', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONx'}) SET n.title = '陆择的任务理解与试炼本意存在偏差、或成后续转折伏笔', n.content = 'I16（曲解为「找女朋友」）对比 I5（弱者=感情受创者、任务是「拯救」）→ 理解偏差埋雷', n.knowledge_level = 3;
MERGE (n:Info {id: 'RINsONAONy'}) SET n.title = '陈默的人生轨迹在21天内已被逆转', n.content = 'E7（删联系方式）→ E9/E10（形象改造）→ E19（首播）→ E25（职业邀约）→「十天前还站在大桥护栏的外侧」→ 从绝境到正轨', n.knowledge_level = 3;
