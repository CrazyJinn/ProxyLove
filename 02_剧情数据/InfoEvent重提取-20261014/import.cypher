MERGE (n:Info {id:'RDRd3Inq7y'}) SET n.title='首播流量来自头条视频', n.content='开播十分钟涌入六百人、两小时峰值一万二——多数循林梦的头条视频而来', n.knowledge_level=1;
MERGE (n:Info {id:'RDRd3Inq7z'}) SET n.title='江烈对陈默充满敌意', n.content='从进门起没给好脸色；以队长身份颐指气使，冲突后撂话「回去等通知」', n.knowledge_level=1;
MERGE (n:Info {id:'RDRd3Inq80'}) SET n.title='苏晓禾的规律晨跑', n.content='每天六点出现在南滨路同一条路线——只是因为她自己要跑；教过的事不追问', n.knowledge_level=1;
MERGE (n:Info {id:'RDRd3Inq81'}) SET n.title='苏晓禾记住了那句「后天见」', n.content='没有套路的、平平常常的一句「后天见」，她记到了晚上', n.knowledge_level=1;
MERGE (n:Info {id:'RDRd3Inq82'}) SET n.title='星耀二队随时可能散伙', n.content='新组建队伍：基地还在装修，前两个月线上训练，效果不好随时散伙（电竞常规操作）', n.knowledge_level=1;
MERGE (n:Info {id:'RDRd3Inq83'}) SET n.title='二队入场券：生活要规律', n.content='训练表定下后不许迟到、不许再接单到凌晨、有事提前请假——「你要先能把生活过成规律的」', n.knowledge_level=1;
MERGE (n:Info {id:'RDRd3Inq84'}) SET n.title='试用期按代练价计薪', n.content='合同等两个月之后签，现在算试用期、先按代练价格算——「有够黑的」', n.knowledge_level=2;
MERGE (n:Choice {id:'RDRd3Inq85'}) SET n.name='跳江选择', n.description='陆择（陈默身）深夜立于长江大桥护栏外侧，意识到身处他人身体后面临的选择', n.time='2024-06-01 23:00:00';
