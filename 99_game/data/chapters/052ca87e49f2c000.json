  "scenes": [
    {
      "id": "R22lVGrBuC",
      "scene": "05141b8c24c00000",
      "time": "夜晚",
      "section_title": "直播与小号火箭",
      "day": 9,
      "lines": [
        {
          "op": "narrate",
          "text": "晚上八点整，陆择开启了直播。"
        },
        {
          "op": "narrate",
          "text": "人气从首播那晚的高位一路往下走，最后堪堪停在一千出头。"
        },
        {
          "op": "say",
          "who": "陆择",
          "portrait": "05475d416b800000",
          "pos": "left",
          "text": "……行吧。一千就一千，总比完全没人看强。",
          "voice": "05475bd505400002"
        },
        {
          "op": "hide",
          "who": "陆择"
        },
        {
          "op": "narrate",
          "text": "弹幕滚得不算快，老面孔居多，问技术的、问今天打几把的，还有人在刷「凉了凉了」。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05080b10e8800000",
          "pos": "left",
          "text": "家人们别刷「凉了凉了」，伤士气。",
          "voice": "05475bd505400004"
        },
        {
          "op": "narrate",
          "text": "嘴上聊着天，手上却没停下。谈笑之间第一把轻松拿下。"
        },
        {
          "op": "narrate",
          "text": "屏幕忽然亮了。三发超级火箭的特效霸占了所有人的屏幕。"
        },
        {
          "op": "narrate",
          "text": "超级火箭，礼物栏里标价最贵的那一档。"
        },
        {
          "op": "narrate",
          "text": "他这种刚起步的小直播间，一个月都未必接得住一发。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475d4e02400000",
          "pos": "left",
          "text": "……好家伙。多谢老板！老板大气，祝老板永远不死，获得永生。",
          "voice": "05475bd505400009"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0512c1e298c00000",
          "pos": "left",
          "text": "话不多说，看一下我们这把阵容……",
          "voice": "05475bd50540000a"
        },
        {
          "op": "narrate",
          "text": "话头带到一半，弹幕的画风不对了。"
        },
        {
          "op": "narrate",
          "text": "「等等，这个ID我见过」「考古了一下，之前就在主播美杜莎视频里面出现过」。"
        },
        {
          "op": "narrate",
          "text": "「嫂子！！！」"
        },
        {
          "op": "hide",
          "who": "陈默"
        },
        {
          "op": "say",
          "who": "陆择",
          "portrait": "04fe016b88800000",
          "pos": "left",
          "text": "哪个天杀的，考古这么快。",
          "voice": "05475bd50540000e"
        },
        {
          "op": "hide",
          "who": "陆择"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05080b0e36c00000",
          "pos": "left",
          "text": "什么嫂子，人家老板心情好，咱们别吓着人家。来来来这盘看我表演——",
          "voice": "05475bd50540000f"
        },
        {
          "op": "narrate",
          "text": "「不装了？」「他急了他急了」。"
        },
        {
          "op": "narrate",
          "text": "「嘴上说不知道，耳朵红没红我们看不见吗」。"
        },
        {
          "op": "narrate",
          "text": "中间又断断续续来了几波小礼物。那个老板号倒是一句话没说，刷完礼物就跑了。"
        },
        {
          "op": "narrate",
          "text": "起哄持续了能有十分钟，弹幕过了劲头自己散了。直播间的记性就这么长，明天有明天的话题。"
        },
        {
          "op": "narrate",
          "text": "播了三小时后，陆择停止了推流。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513a564fa000000",
          "pos": "left",
          "text": "下了下了，家人们早点睡，明儿见。",
          "voice": "05475bd505400015"
        },
        {
          "op": "narrate",
          "text": "屋里一下子只剩风扇声。他摘下耳机挂回架子，站起来准备去烧水。"
        },
        {
          "op": "transition",
          "track": "05475bd505400017"
        },
        {
          "op": "narrate",
          "text": "手机震了起来，是林梦。"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "052c61c326c00000",
          "pos": "right",
          "text": "忙完啦？",
          "voice": "05475bd505400019"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513a55d44c00000",
          "pos": "left",
          "text": "刚下播。这么晚，有事？",
          "voice": "05475bd505400026"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521bf8673c00000",
          "pos": "right",
          "text": "没事就不能找你？说，今天是不是有事瞒我。",
          "voice": "05475bd505400027"
        },
        {
          "op": "narrate",
          "text": "陆择把水壶放下。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475376eb000000",
          "pos": "left",
          "text": "……你消息倒是灵通。",
          "voice": "05475bd505400029"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521bf83ee800000",
          "pos": "right",
          "text": "废话，我可是你的天使投资人。给我老实交代。",
          "voice": "05475bd50540002a"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0512c1e298c00000",
          "pos": "left",
          "text": "星耀邀请我加入他们的二队。",
          "voice": "05475bd50540002b"
        },
        {
          "op": "narrate",
          "text": "那头静了一秒。"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "05475d7631000000",
          "pos": "right",
          "text": "等会儿，这和我听说的怎么不一样！",
          "voice": "05475bd50540002d"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513a55d44c00000",
          "pos": "left",
          "text": "你听到的是什么版本。",
          "voice": "05475bd50540002e"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521c8230c000001",
          "pos": "right",
          "text": "我是听说你试训没过，还打算安慰一下你来着。",
          "voice": "05475bd50540002f"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475376eb000000",
          "pos": "left",
          "text": "我咋觉得你本来是打算来给我伤口上撒盐的……",
          "voice": "05475bd505400030"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521bf83ee800000",
          "pos": "right",
          "text": "闭嘴让我高兴一会儿！看看，看看！本小姐看人的眼光什么时候差过？",
          "voice": "05475bd505800000"
        },
        {
          "op": "narrate",
          "text": "耳机里她语速快得像滚屏，从他首播的剪辑数到昨天的邀约，中间夹了三遍「潜力股」、两遍「我就说」。陆择靠在椅背上听，不知道该先纠正哪一句。"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521c8230c000000",
          "pos": "right",
          "text": "星耀那边谁找的你？",
          "voice": "05475bd505800002"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0512c1e298c00000",
          "pos": "left",
          "text": "他们经理。",
          "voice": "05475bd505800003"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "05475d7631000000",
          "pos": "right",
          "text": "传说中的雪姐？",
          "voice": "05475bd505800004"
        },
        {
          "op": "narrate",
          "text": "他握着水杯的手停了半拍。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513a55d44c00000",
          "pos": "left",
          "text": "……你认识？",
          "voice": "05475bd505800006"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521bf8673c00000",
          "pos": "right",
          "text": "认识？圈内谁不认识她！哎不对，你等着，从头说。你们是怎么聊的，她说了几句，你答了几句，原话，一个字不许漏。",
          "voice": "05475bd505800007"
        },
        {
          "op": "narrate",
          "text": "接下来的十分钟，火力比团战还密集，根本不给他喝水的空当。"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521c8230c000000",
          "pos": "right",
          "text": "沈暮雪穿了什么？坐哪个位置？是不是她先点的单？说话的时候看没看手机？签约几年？工资几号发？",
          "voice": "05475bd505800009"
        },
        {
          "op": "narrate",
          "text": "他试着把话题拽回来两次，没拽动。第三次干脆不拽了，捡着能答的答，答不上来的说忘了。她也不恼，转头换个方向继续问。"
        },
        {
          "op": "narrate",
          "text": "问到后来，连「她咖啡喝不喝冰的」都出来了。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475376eb000000",
          "pos": "left",
          "text": "我怎么知道。",
          "voice": "05475bd50580000c"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521bf88f5c00000",
          "pos": "right",
          "text": "你观察力不行，算了。",
          "voice": "05475bd50580000d"
        },
        {
          "op": "narrate",
          "text": "陆择终于没绷住，抬手把麦克风捂住，笑出了声。"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521c8230c000001",
          "pos": "right",
          "text": "你笑什么？",
          "voice": "05475bd50580000f"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05080b0e36c00000",
          "pos": "left",
          "text": "没什么。",
          "voice": "05475bd505800010"
        },
        {
          "op": "say",
          "who": "林梦",
          "portrait": "0521c8230c000001",
          "pos": "right",
          "text": "哼。行了不聊了，本小姐明天还有事。你也早点睡，别学我熬夜。",
          "voice": "05475bd505800011"
        },
        {
          "op": "transition",
          "track": "05475bd505800012"
        },
        {
          "op": "hide",
          "who": "林梦"
        },
        {
          "op": "narrate",
          "text": "屋里重新静了下来。"
        }
      ],
      "bgm": {
        "track": "0514da4018c00000",
        "mode": "play",
        "loop": true
      }
    },
    {
      "id": "QW7CSvlX5k",
      "scene": "04fb5737eb800000",
      "time": "清晨",
      "section_title": "雨中超市与日程",
      "day": 11,
      "lines": [
        {
          "op": "narrate",
          "text": "六点多的滨江步道，江面浮着一层灰白的雾。"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "Hi。",
          "voice": "054750e6ef800001"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "早。",
          "voice": "054750e6ef800002"
        },
        {
          "op": "narrate",
          "text": "他把步子放小半格，落到她外侧。江风从水面上过来，带着腥的潮气。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05221fe336400000",
          "pos": "right",
          "text": "最近工作怎么样，忙不忙？",
          "voice": "054750e6ef800004"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "不忙，挺闲的，每天都能摸鱼刷一下短视频。",
          "voice": "054750e6ef800005"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "哦？那你看短剧么？",
          "voice": "054750e6ef800006"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe1135b4c00000",
          "pos": "left",
          "text": "试过，看不进去。我还是比较喜欢看历史剧。",
          "voice": "054750e6ef800007"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "女孩子看历史剧，还挺稀罕的。",
          "voice": "054750e6ef800008"
        },
        {
          "op": "narrate",
          "text": "两人有一搭没一搭地聊着，突然天暗了下来。风中夹杂着湿润的气息，江对岸的楼群糊成一团。"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0547535b20c00000",
          "pos": "right",
          "text": "糟糕，要下雨了。",
          "voice": "054750e6ef80000a"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe1135b4c00000",
          "pos": "left",
          "text": "前面左拐有一个小超市，我们去那里避避雨。",
          "voice": "054750e6ef80000b"
        },
        {
          "op": "bed_start",
          "bed": "rain",
          "track": "054750e6ef80000c"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "跑起来跑起来！",
          "voice": "054750e6ef80000d"
        },
        {
          "op": "bed_end",
          "bed": "rain"
        },
        {
          "op": "narrate",
          "text": "说着，她的身影如同小鹿一样窜了出去。"
        },
        {
          "op": "narrate",
          "text": "陆择跟了百来米，一口气没喘上来岔了气，只能缓下了脚步。"
        },
        {
          "op": "narrate",
          "text": "她先一步钻进超市门口的雨棚，转身看他还在十几米外深一脚浅一脚，笑得肩膀直抖。"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113ab4400000",
          "pos": "left",
          "text": "这么慢，你不太行啊。",
          "voice": "054750e6ef800012"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "你懂啥，这叫成熟稳重。「莫听穿林打叶声，何妨吟啸且徐行」。",
          "voice": "054750e6ef800013"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113ab4400000",
          "pos": "left",
          "text": "呵，墨水还挺多。",
          "voice": "054750e6ef800014"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "走吧，我们进去逛逛，我正好买点菜。",
          "voice": "054750e6ef800015"
        }
      ],
      "bgm": {
        "track": "0514f8f64a000000",
        "mode": "play",
        "loop": true
      }
    },
    {
      "id": "Re2PEUaYTp",
      "scene": "05319467c6c00001",
      "time": "清晨",
      "section_title": "雨中超市与日程",
      "day": 11,
      "lines": [
        {
          "op": "transition",
          "track": "054750e6ef800016"
        },
        {
          "op": "narrate",
          "text": "早班的灯只开了一半，收银台后面的小妹在打哈欠。"
        },
        {
          "op": "narrate",
          "text": "陆择拎了篮子。货架之间的过道窄，两个人并排走，胳膊偶尔碰一下。"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "哎，这个老酸奶你吃过没，我觉得超好吃。",
          "voice": "054750e6ef800019"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "好像之前有新闻说，老酸奶都是用旧皮鞋做的。",
          "voice": "054750e6ef80002e"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "0547533cd5400000",
          "pos": "left",
          "text": "啊？我还挺爱吃这一款的说。",
          "voice": "054750e6ef80002f"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "很久以前看的新闻了，还看到过用纸箱馅做包子。",
          "voice": "054750e6ef800030"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113ab4400000",
          "pos": "left",
          "text": "真的假的。你懂这么多，是新闻从业者么？",
          "voice": "054750e6ef800031"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475367b4c00000",
          "pos": "right",
          "text": "呃，我其实是玩游戏的，算是半个职业选手。",
          "voice": "054750e6ef800032"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "哇，那你还挺厉害的。",
          "voice": "054750e6ef800033"
        },
        {
          "op": "bed_start",
          "bed": "rain_muffled",
          "track": "054750e6ef800034"
        },
        {
          "op": "narrate",
          "text": "雨在玻璃门外下成一道帘子。两个人拎着篮子慢慢逛，苏晓禾买了一盒鸡蛋、几把青菜和一小份甜品。"
        },
        {
          "op": "bed_end",
          "bed": "rain_muffled"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "你居然吃甜食，我还以为你要保持身材呢。",
          "voice": "054750e6ef800037"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe1135b4c00000",
          "pos": "left",
          "text": "怎么，我身材不好么？",
          "voice": "054750e6ef800038"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1cc9400000",
          "pos": "right",
          "text": "不不不，你身材很棒。",
          "voice": "054750e6ef800039"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "嘻嘻。还不知道你叫什么呢。",
          "voice": "054750e6ef80003a"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475367b4c00000",
          "pos": "right",
          "text": "呃……陈默。耳东陈，沉默的默。你呢？",
          "voice": "054750e6ef80003b"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe1135b4c00000",
          "pos": "left",
          "text": "我叫苏晓禾。拂晓的晓，禾苗的禾。",
          "voice": "054750e6ef80003c"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513fc1f54800000",
          "pos": "right",
          "text": "你名字真好听。我们加个微信吧。",
          "voice": "054750e6ef80003d"
        },
        {
          "op": "say",
          "who": "苏晓禾",
          "portrait": "04fe113d33000000",
          "pos": "left",
          "text": "好呀。",
          "voice": "054750e6ef80003e"
        },
        {
          "op": "narrate",
          "text": "两人互换了微信。"
        },
        {
          "op": "narrate",
          "text": "雨来得快去得也快。两人结完账，互道了别。"
        }
      ],
      "bgm": {
        "track": "053c7dcb0cc00000",
        "mode": "play",
        "loop": true
      }
    },
    {
      "id": "sec01-R22lVGrBuC",
      "scene": "05141b8c24c00000",
      "time": "夜晚",
      "section_title": "雨中超市与日程",
      "day": 11,
      "lines": [
        {
          "op": "narrate",
          "text": "晚上陆择刚下播，手机屏幕就亮了起来。"
        },
        {
          "op": "say",
          "who": "沈暮雪",
          "portrait": "051415cabd000000",
          "pos": "left",
          "text": "二队人员齐了。",
          "voice": "054750e6ef800042"
        },
        {
          "op": "say",
          "who": "沈暮雪",
          "portrait": "051415cabd000000",
          "pos": "left",
          "text": "训练日程我给你发过去了，你自己看。",
          "voice": "054750e6ef800043"
        },
        {
          "op": "narrate",
          "text": "他把日程从头看到尾，回：「收到。」"
        },
        {
          "op": "say",
          "who": "沈暮雪",
          "portrait": "051415cabd000000",
          "pos": "left",
          "text": "明天下午再来星耀一趟，签一份合作意向书。",
          "voice": "054750e6ef800045"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "0513a55d44c00000",
          "pos": "right",
          "text": "不是暂时不签合同么？",
          "voice": "054750e6ef800046"
        },
        {
          "op": "say",
          "who": "沈暮雪",
          "portrait": "051415cabd000000",
          "pos": "left",
          "text": "意向书，是保证俱乐部到时候能和你有优先签约权。",
          "voice": "054750e6ef800047"
        },
        {
          "op": "say",
          "who": "陈默",
          "portrait": "05475376eb000000",
          "pos": "right",
          "text": "搞这么复杂。",
          "voice": "054750e6ef800048"
        },
        {
          "op": "say",
          "who": "沈暮雪",
          "portrait": "051415cabd000000",
          "pos": "left",
          "text": "明天见。",
          "voice": "054750e6ef800049"
        }
      ],
      "bgm": {
        "track": "0514da4018c00000",
